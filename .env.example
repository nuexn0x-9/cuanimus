# ==============================================================================
# CUANIMUS ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# Copy this file to .env and fill in your real credentials.
# ==============================================================================

# System Environment
ENVIRONMENT=development
TZ=Asia/Jakarta
LOG_LEVEL=INFO

# Exchange API Credentials (Binance Futures)
# NOTE: Restrict API permissions to "Enable Reading" and "Enable Futures" ONLY.
# NEVER enable "Withdrawals" or "Spot Margin Transfer".
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Intelligence Layer (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Freqtrade API Server
API_SERVER_USERNAME=cuanimus_admin
API_SERVER_PASSWORD=change_this_to_a_secure_password
JWT_SECRET_KEY=change_this_to_a_random_32_character_string_for_security

# Database Configuration
# Explicit path inside the persistent mounted volume
DB_URL=sqlite:////freqtrade/user_data/tradesv3.dryrun.sqlite

# Docker & Container Ports
CUANIMUS_PORT=8888
MCP_PORT=8889
POSTGRES_PORT=5432
POSTGRES_PASSWORD=cuanimus_secret_pass
